NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Legacy projects can use this instead of the publishable key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_legacy_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_for_webhooks_only

# OpenAI
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-5.2

# PayPal - segunda pasada del MVP
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
PAYPAL_PLAN_ID=your_paypal_plan_id
